{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/", "destination": "/index.htm" }
  ],
  "headers": [
    {
      "source": "/api/fetchLive",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "s-maxage=15, stale-while-revalidate=30" }
      ]
    }
  ]
}
